# ── RTSP Camera URLs (comma-separated) ──────────────────────────────────────
RTSP_URLS=rtsp://admin:password@192.168.1.100:554/stream1,rtsp://admin:password@192.168.1.101:554/stream1

# ── Storage paths ────────────────────────────────────────────────────────────
STORAGE_PATH=./data/recordings
DB_PATH=./data/metadata.db
FAISS_INDEX_PATH=./data/faiss_index/index.faiss
CLIPS_DIR=./data/clips

# ── LLM provider: anthropic | openai ─────────────────────────────────────────
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# ── Ingestion settings ────────────────────────────────────────────────────────
SAMPLING_FPS=1          # frames written to disk per second
INDEXING_FPS=0.5        # frames embedded + indexed per second
MOTION_THRESHOLD=500    # min changed pixels to consider a frame as motion
SEGMENT_DURATION=300    # seconds per .mp4 segment file

# ── Detection settings ────────────────────────────────────────────────────────
YOLO_MODEL_PATH=./models/yolov8n_openvino_model
DETECTION_CONFIDENCE=0.4
# OpenVINO device: GPU = Intel Iris Xe iGPU, CPU = fallback
OPENVINO_DEVICE=GPU

# ── FAISS search settings ──────────────────────────────────────────────────────
FAISS_NLIST=100         # IVF cluster count
FAISS_NPROBE=10         # clusters probed per query
TOP_K_RESULTS=10
CLIP_DURATION_SECONDS=15    # total length (s) of an extracted clip, centered on the matched frame
EVENT_DEDUP_SECONDS=15      # collapse same-camera detections within this gap into one result

# ── API settings ──────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
